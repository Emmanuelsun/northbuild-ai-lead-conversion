    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const raw = $json.content?.parts?.[0]?.text ?? '';\n\nlet ai;\ntry {\n  const cleaned = raw.replace(/```json|```/g, '').trim();\n  ai = JSON.parse(cleaned);\n} catch (e) {\n  ai = {\n    category: 'needs_review',\n    score: 0,\n    summary: 'AI response could not be read',\n    intent: 'unknown',\n    urgency: 'unknown',\n    in_service_area: 'unknown',\n    confidence: 0,\n    draft_reply: ''\n  };\n}\n\nconst lead = $('Edit Fields').item.json;\n\nreturn { json: { ...lead, ...ai } };"
      },
